---
import '../styles/global.css';
import '@fontsource-variable/space-grotesk';
import Mark from '../components/Mark.astro';
import ViewCount from '../components/ViewCount.astro';
/** Shared metadata and navigation for every static page. */
interface Props {
  /** Page title, excluding the site name. */
  title: string;
  /** Search and social description. */
  description?: string;
  /** Page-specific class added to the document body. */
  class?: string;
  /** Publication metadata for a technical article or a long-form life entry. */
  article?: {
    /** Original publication date or ISO timestamp. */
    publishedTime?: string;
    /** Most recent author-maintained revision timestamp. */
    modifiedTime?: string;
    /** Main editorial category, when present. */
    section?: string;
    /** Independent topic labels. */
    tags?: string[];
  };
}
const { title, description = 'Eynnzerr 的个人空间。写代码，听音乐，记录生活中值得留下的事。', class: className = '', article } = Astro.props;
const path = Astro.url.pathname;
const navigation = [['/', '首页', 'Home'], ['/blog/', '博客', 'Writing'], ['/projects/', '作品', 'Projects'], ['/life/', '生活', 'Life'], ['/about/', '关于', 'About']];
const notFound = path === '/404/' || path === '/404.html';
const canonicalPath = path.replace(/^\/page\/(\d+)\/$/, '/blog/page/$1/').replace(/^\/blog\/page\/1\/$/, '/blog/');
const canonical = new URL(notFound ? '/404.html' : canonicalPath, Astro.site);
const pageTitle = title === 'Eynnzerr' ? 'Eynnzerr — Code, sound & everything in between' : `${title} · Eynnzerr`;
const socialImage = new URL('/images/social-card.png', Astro.site);
const socialImageAlt = 'Eynnzerr — Code, sound & everything in between. 青绿与铜橙色线条构成的空间曲面。';
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#142127" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eynnzerr" />
    {notFound && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Eynnzerr" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {article && <meta property="article:author" content={new URL('/about/', Astro.site)} />}
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="Eynnzerr 的文章" href="/atom.xml" />
    <script is:inline>
      try {
        if (localStorage.getItem('eynnzerr-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f5f4ef');
        }
      } catch {}
    </script>
  </head>
  <body class={className}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Eynnzerr 首页"><Mark /><span>Eynnzerr<span class="brand-period">.</span></span></a>
      <nav aria-label="主导航">
        {navigation.map(([href, label, english]) => (
          <a href={href} class:list={{ active: href === '/' ? path === '/' : path.startsWith(href) }} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>
            <span>{label}</span><span class="nav-en">{english}</span>
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <button class="theme-toggle icon-button" aria-label="切换深浅配色" title="切换深浅配色"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="7"/><path d="M12 5a7 7 0 0 1 0 14Z" fill="currentColor"/></svg></button>
        <a href="https://github.com/Eynnzerr" target="_blank" rel="noreferrer" class="header-github" aria-label="GitHub 主页">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href="/" class="brand"><Mark size={36} /><span>Eynnzerr.</span></a><p>保持好奇。保持共鸣。</p><a href="#main-content" class="back-top">回到顶部 ↑</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Eynnzerr</span><span>Made with code & a little bass.</span><div><a href="/atom.xml">RSS ↗</a><a href="mailto:eynnzerr@gmail.com">Email ↗</a><a href="https://space.bilibili.com/21157246" target="_blank" rel="noreferrer">Bilibili ↗</a></div></div>
      <div class="footer-views"><ViewCount scope="site" /></div>
    </footer>
    <script>
      /** Switch the shared page and sculpture palette, persisting the reader's choice. */
      function toggleTheme() {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#142127' : '#f5f4ef');
        try { localStorage.setItem('eynnzerr-theme', dark ? 'dark' : 'light'); } catch {}
      }
      document.querySelector('.theme-toggle')?.addEventListener('click', toggleTheme);
      const revealObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); }
      }, { threshold: 0.07 });
      document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
    </script>
  </body>
</html>
