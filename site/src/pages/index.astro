---
import BaseLayout from '../layouts/BaseLayout.astro';
import Resonance from '../components/Resonance.astro';
import RhythmGame from '../components/RhythmGame.astro';
import { getPosts, formatDate } from '../lib/posts';
import { DEFAULT_TRACK_ID, getTrack } from '../lib/rhythm-chart';
const posts = (await getPosts()).slice(0, 3);
/** Default track metadata also used by the selectable rhythm player. */
const track = getTrack(DEFAULT_TRACK_ID);
---
<BaseLayout title="Eynnzerr" class="home-page">
  <section class="hero" data-hero-stage data-mode="home">
    <Resonance />
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-content wide-container">
      <div class="hero-eyebrow"><span class="live-dot"></span> A PERSONAL SPACE BY EYNNZERR <span class="edition">VOL. 01 / 2026</span></div>
      <div class="hero-copy"><p class="hero-hello">你好，我是 Eynnzerr</p><h1><span class="hero-word hero-word-code">Code.</span><span class="hero-word hero-word-feel">Feel.</span><span class="hero-word outline-word">Repeat.</span><span class="hero-star" aria-hidden="true">✳</span></h1><p class="hero-description">在代码与旋律之间，<br />留一点空间给好奇心。</p><div class="hero-links"><button class="hero-play" type="button" data-enter-rhythm aria-controls="hero-rhythm" aria-expanded="false"><span class="play-symbol" aria-hidden="true">▷</span> 听见我的节奏 <span>↗</span></button><a class="hero-reading" href="/blog/">读一些文字 <span>↗</span></a></div></div>
      <div class="hero-bottom"><span>DRIVEN BY CURIOSITY.<br /><b>MOVED BY MUSIC.</b></span><a href="#writing" class="scroll-note">向下探索 <span>↓</span></a><span class="hero-coordinate">CODE · MUSIC · LIFE<br /><b>ALWAYS IN THE MAKING</b></span></div>
    </div>
    <div class="hero-transition" aria-hidden="true"><i></i><i></i><i></i><i></i><span></span></div>
    <div class="hero-game" id="hero-rhythm" data-hero-game inert aria-hidden="true">
      <div class="hero-game-toolbar"><div class="hero-track"><span class="hero-track-dot"></span><span>EYNNZERR <b>/</b> <span data-hero-track-title>{track.title.toUpperCase()}</span><small data-hero-track-meta>{track.bpm} BPM · {track.key.toUpperCase()} · {track.genre.toUpperCase()}</small></span></div><button class="hero-exit" type="button" data-exit-rhythm><span aria-hidden="true">↖</span> 回到首页 <kbd>ESC</kbd></button></div>
      <div class="hero-game-body"><RhythmGame embedded /></div>
      <span class="hero-game-watermark" aria-hidden="true">FEEL THE BEAT.</span>
    </div>
    <div class="hero-marquee" aria-hidden="true"><div>BUILD THINGS · FEEL THINGS · STAY CURIOUS · BUILD THINGS · FEEL THINGS · STAY CURIOUS ·&nbsp;</div></div>
  </section>

  <section id="writing" class="writing-section section container">
    <div class="writing-intro" data-reveal>
      <div><span class="eyebrow">01 / NOTES & EXPLORATIONS</span><h2>写下来，想明白。</h2><p>喜欢把想法写成代码，也喜欢被一段旋律击中。<br />这里记录技术、实践与沿途的思考。</p></div>
      <div class="writing-links"><a class="text-link writing-about" href="/about/">再认识我一点 ↗</a><a class="text-link" href="/blog/">全部文章 ↗</a></div>
    </div>
    <div class="home-posts">{posts.map((post, index) => <a class="home-post" href={post.url} data-reveal><span class="post-index">0{index + 1}</span><div class="post-copy"><div class="post-meta"><span>{post.categories[0] || post.tags[0] || '随记'}</span><time datetime={post.date.toISOString()}>{formatDate(post.date)}</time></div><h3>{post.title}</h3><p>{post.description}</p><span class="post-reading">{post.readingMinutes} 分钟阅读</span></div><span class="post-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="section container projects-section">
    <div class="section-heading" data-reveal><div><span class="eyebrow">02 / THINGS I'VE BUILT</span><h2>让想法有个形状。</h2></div><a class="text-link" href="/projects/">作品画廊 ↗</a></div>
    <div class="home-projects"><a class="home-project bandori" href="/projects/#bandori" data-reveal><div class="project-stage"><span class="project-stage-label">AN IDEA, ACROSS PLATFORMS.</span><div class="phone phone-one"><img src="/projects/bandori-1.jpg" alt="BandoriStation Mobile 车站列表界面" loading="lazy" width="1080" height="2400" /></div><div class="phone phone-two"><img src="/projects/bandori-2.jpg" alt="BandoriStation Mobile 房间详情界面" loading="lazy" width="1080" height="2400" /></div><span class="stage-number">01</span></div><div class="project-caption"><div><h3>BandoriStation Mobile</h3><p>把音游里的同好，连接到一起。</p></div><span>↗</span></div><div class="project-tags"><span>Compose Multiplatform</span><span>Android / iOS / Desktop</span></div></a><a class="home-project fish" href="/projects/#blue-fish" data-reveal><div class="project-stage"><span class="project-stage-label">A LITTLE TOOL. A LOT OF JOY.</span><img class="desktop-shot" src="/projects/blue-fish.png" alt="大肥鱼表情工坊网页编辑器" loading="lazy" width="1600" height="1000"/><span class="stage-number">02</span></div><div class="project-caption"><div><h3>Blue Fish Studio</h3><p>给灵感配上表情，让快乐顺手发生。</p></div><span>↗</span></div><div class="project-tags"><span>React / Canvas</span><span>Web</span></div></a></div>
  </section>

  <section class="offscreen container" data-reveal><div class="offscreen-copy"><span class="eyebrow">03 / BEYOND THE SCREEN</span><h2>屏幕之外，<br />也有正在发生的事。</h2><p>一些现场，一些片刻，一些还没整理好的想法。</p><a class="button outline" href="/life/">去生活里看看 ↗</a></div><div class="offscreen-art" aria-hidden="true"><span class="ticket-stamp">OFFLINE<br />MOMENTS</span><div class="ticket-lines"></div><span class="ticket-small">GOOD MUSIC. GOOD MEMORIES.</span><span class="ticket-star">✳</span></div></section>
</BaseLayout>
<script>
  import { initializeHeroStage } from '../scripts/hero-stage';
  initializeHeroStage();
</script>
<style>
  /* The sculpture shares the page palette; only an active music stage dims the background. */
  .hero{
    --hero-ink:#1d433c;--hero-outline:#43766a;--hero-muted:#526f65;--hero-faint:#6b8075;
    --hero-accent:#3d836c;--hero-warm:#bc7954;--hero-dot-glow:#5d997c33;
    --hero-grid:#264e3c06;--hero-line:#3454421a;--hero-button-border:#42785d45;
    --hero-button-bg:#63947710;--hero-button-hover:#63947725;
    --hero-aura:radial-gradient(ellipse,#83b4a925,transparent 65%);
    --sculpture-opacity-tablet:.8;--sculpture-opacity-mobile:.65;
  }
  :global(:root[data-theme=dark]) .hero{
    --hero-ink:#eaf0df;--hero-outline:#dde8d4;--hero-muted:#b5c5bb;--hero-faint:#829b8f;
    --hero-accent:#b9e3c4;--hero-warm:#f2a37f;--hero-dot-glow:#b9e3c460;
    --hero-grid:#ffffff03;--hero-line:#e5f1dc18;--hero-button-border:#a7d8bd55;
    --hero-button-bg:#b7eac31a;--hero-button-hover:#b7eac333;
    --hero-aura:radial-gradient(ellipse,#a0e9cb22,transparent 65%);
    --sculpture-opacity-tablet:.7;--sculpture-opacity-mobile:.55;
  }
  .hero{background:var(--bg);color:var(--hero-ink);transition:background-color .9s cubic-bezier(.4,0,.2,1),color .55s;position:relative;overflow:hidden;min-height:820px;--hero-min:820px}.hero-content{position:relative;z-index:3;padding-top:37px}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--hero-grid) 1px,transparent 1px),linear-gradient(90deg,var(--hero-grid) 1px,transparent 1px);background-size:92px 92px;mask-image:linear-gradient(90deg,transparent,#000)}.hero-eyebrow{font:10px var(--font-display);letter-spacing:.15em;display:flex;align-items:center;gap:11px;color:var(--hero-muted)}.live-dot{width:6px;height:6px;border-radius:50%;background:var(--hero-accent);box-shadow:0 0 16px var(--hero-dot-glow)}.edition{margin-left:auto;font-size:9px;color:var(--hero-faint)}.hero-copy{padding:58px 0 48px;position:relative;max-width:750px}.hero-hello{font-size:13px;color:var(--hero-muted);margin-bottom:23px;letter-spacing:.07em}.hero h1{font:500 clamp(83px,9.2vw,138px)/.95 var(--font-display);letter-spacing:-.075em;margin:0 0 26px;position:relative;width:fit-content}.hero-word{display:block;transform-origin:left center;will-change:transform,opacity,filter}.outline-word{-webkit-text-stroke:1px var(--hero-outline);color:transparent}.hero-star{position:absolute;font:100 64px var(--font-display);right:-96px;top:4px;color:var(--hero-warm);animation:starspin 24s linear infinite}.hero-description{font-size:16px;line-height:1.9;letter-spacing:.09em;color:var(--hero-muted);position:absolute;left:430px;bottom:158px;white-space:nowrap}.hero-links{display:flex;align-items:center;gap:30px;margin-top:40px}.hero-play{font-family:inherit;color:inherit;display:flex;align-items:center;gap:16px;border:1px solid var(--hero-button-border);padding:12px 22px;border-radius:50px;font-size:12px;background:var(--hero-button-bg);transition:background .2s}.hero-play:hover{background:var(--hero-button-hover)}.hero-play>span:last-child{margin-left:14px}.play-symbol{font-size:20px;line-height:1}.hero-reading{font-size:12px;color:var(--hero-muted)}.hero-reading span{margin-left:13px}.hero-bottom{display:flex;justify-content:space-between;align-items:end;padding-bottom:38px;font:9px/1.8 var(--font-display);letter-spacing:.1em;color:var(--hero-muted)}.hero-bottom b{font-weight:400;color:var(--hero-faint)}.scroll-note{font:11px var(--font-body);color:var(--hero-muted);display:flex;gap:16px;align-items:center}.scroll-note span{display:inline-grid;place-items:center;border:1px solid var(--hero-button-border);border-radius:50%;width:30px;height:40px;animation:nudge 2s ease-in-out infinite}.hero-coordinate{text-align:right}.hero-marquee{border-top:1px solid var(--hero-line);border-bottom:1px solid var(--hero-line);padding:15px 0;font:500 14px var(--font-display);color:var(--hero-faint);letter-spacing:.2em;white-space:nowrap;overflow:hidden}.hero-marquee div{width:max-content;animation:marquee 40s linear infinite}.home-post{display:grid;grid-template-columns:65px 1fr 60px;align-items:center;gap:24px;padding:30px 0;border-top:1px solid var(--line);transition:padding .3s}.home-post:last-child{border-bottom:1px solid var(--line)}.home-post:hover{padding-inline:14px}.post-index{font:13px var(--font-display);color:var(--muted);align-self:start;padding-top:5px}.post-meta{display:flex;gap:20px;align-items:center;font-size:11px;color:var(--muted);margin-bottom:12px}.post-meta>span{color:var(--accent)}.post-copy h3{font-size:25px;font-weight:600;letter-spacing:-.03em;margin:0 0 10px}.post-copy>p{font-size:13px;color:var(--muted);margin:0;max-width:780px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical}.post-reading{font-size:10px;color:var(--muted);display:block;margin-top:12px}.post-arrow{width:46px;height:46px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;font-size:20px;transition:background .2s}.home-post:hover .post-arrow{background:var(--accent);color:var(--bg);border-color:var(--accent)}
  .home-projects{display:grid;grid-template-columns:1fr 1fr;gap:32px}.project-stage{height:350px;border-radius:3px;position:relative;overflow:hidden;background:#d8dcd5}.bandori .project-stage{background:#dadbd4}.fish .project-stage{background:#d1e5e4}.project-stage-label{position:absolute;top:25px;left:26px;z-index:2;font:9px var(--font-display);letter-spacing:.12em;color:#374941}.stage-number{position:absolute;bottom:17px;left:25px;font:44px var(--font-display);color:#31493842}.phone{position:absolute;width:155px;height:340px;top:70px;background:#1b2223;border:5px solid #1b2223;border-radius:21px;box-shadow:12px 15px 28px #243b3022;overflow:hidden;transition:transform .6s}.phone img{width:100%;height:100%;object-fit:cover;object-position:top}.phone-one{left:22%;transform:rotate(-10deg)}.phone-two{left:49%;top:105px;transform:rotate(8deg)}.home-project:hover .phone-one{transform:rotate(-6deg) translateY(-10px)}.home-project:hover .phone-two{transform:rotate(4deg) translateY(-8px)}.desktop-shot{position:absolute;width:93%;max-width:none;top:100px;left:13%;border:5px solid #fbfcf9;border-radius:8px;box-shadow:0 20px 35px #25493d30;transform:rotate(-5deg);transition:transform .6s}.home-project:hover .desktop-shot{transform:rotate(-2deg) translateY(-10px)}.project-caption{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:22px}.project-caption h3{font:500 22px var(--font-display);letter-spacing:-.04em;margin-bottom:7px}.project-caption p{font-size:12px;color:var(--muted);margin:0}.project-caption>span{font-size:24px}.project-tags{display:flex;gap:20px;font:10px var(--font-display);color:var(--muted);margin-top:18px}.offscreen{padding:50px 0 100px;display:grid;grid-template-columns:1.1fr 1fr;gap:90px;align-items:center}.offscreen h2{font-size:36px;line-height:1.5;margin:20px 0 17px;font-weight:500}.offscreen p{font-size:13px;color:var(--muted);margin-bottom:26px}.offscreen-art{height:290px;background:#e8a78a;transform:rotate(4deg);position:relative;overflow:hidden;box-shadow:10px 14px 0 var(--surface-alt);border-radius:3px;padding:30px;color:#482f23}.ticket-stamp{font:500 52px/.98 var(--font-display);letter-spacing:-.05em}.ticket-small{font:9px var(--font-display);position:absolute;bottom:28px;left:30px;letter-spacing:.16em}.ticket-star{font-size:130px;line-height:1;position:absolute;right:15px;bottom:45px}.ticket-lines{position:absolute;height:70px;width:140px;right:27px;top:30px;background:repeating-linear-gradient(90deg,#482f23 0 1px,transparent 1px 6px);opacity:.35;transform:rotate(90deg)}@keyframes marquee{to{transform:translateX(-45%)}}@keyframes starspin{to{transform:rotate(360deg)}}@keyframes nudge{50%{transform:translateY(5px)}}
  @media(min-width:1600px){.hero{min-height:900px;--hero-min:900px}.hero-copy{padding-top:80px;padding-bottom:75px}.hero h1{font-size:150px}.hero-description{left:470px}}
  @media(max-width:1100px){.hero-description{left:370px;bottom:147px}.phone-one{left:18%}.phone-two{left:46%}.project-stage{height:310px}.offscreen{gap:55px}.hero{min-height:auto;--hero-min:0px}}
  @media(max-width:800px){.hero-copy{max-width:550px;padding-top:55px;padding-bottom:50px}.hero h1{font-size:102px}.hero-description{position:static;margin-top:25px;font-size:14px}.hero-links{margin-top:26px}.hero-bottom{padding-top:20px}.hero-star{font-size:48px;right:-65px}.home-projects{gap:22px}.project-stage{height:280px}.phone{width:120px;height:267px}.phone-one{left:10%}.phone-two{left:44%}.desktop-shot{top:100px}.offscreen{gap:25px}.offscreen h2{font-size:28px}.offscreen-art{height:230px;padding:23px}.ticket-stamp{font-size:39px}.ticket-star{font-size:90px}.ticket-small{left:23px;font-size:8px}.ticket-lines{right:12px;width:80px;height:45px}}
  @media(max-width:600px){.hero-content{padding-top:24px}.hero-eyebrow{font-size:8px;letter-spacing:.1em}.edition{font-size:7px}.hero-copy{padding-top:45px;padding-bottom:35px}.hero h1{font-size:89px}.hero-hello{font-size:12px}.hero-star{right:-52px;font-size:39px;top:6px}.hero-description{font-size:13px;line-height:1.8}.hero-play{font-size:11px;padding:11px 16px;gap:10px}.hero-links{gap:20px}.hero-reading{font-size:11px}.hero-bottom{font-size:8px;gap:12px;padding-bottom:28px}.hero-coordinate{display:none}.hero-marquee{font-size:11px;padding:13px 0}.home-post{grid-template-columns:25px 1fr 30px;gap:13px;padding:25px 0}.post-index{font-size:10px}.post-copy h3{font-size:20px}.post-copy>p{font-size:12px;-webkit-line-clamp:2}.post-arrow{width:30px;height:30px;font-size:16px}.post-meta{font-size:10px;gap:15px}.home-projects{grid-template-columns:1fr;gap:36px}.project-stage{height:310px}.phone{width:150px;height:330px}.phone-one{left:18%}.phone-two{left:48%}.desktop-shot{top:95px}.offscreen{grid-template-columns:1fr;padding:10px 0 65px;gap:35px}.offscreen-art{height:230px;margin:0 12px}.offscreen h2{font-size:30px}.project-caption h3{font-size:21px}}
  .hero:is([data-mode=entering],[data-mode=game]){background:#101e24}
  .hero:is([data-mode=entering],[data-mode=game],[data-mode=exiting]){min-height:max(var(--hero-min),var(--game-height,0px))}
  .hero-hello,.hero-description,.hero-links,.hero-bottom,.hero-eyebrow,.hero-marquee{transition:opacity .5s ease,transform .7s cubic-bezier(.22,1,.36,1),filter .6s ease}.hero-word{transition:transform .85s cubic-bezier(.22,1,.36,1),opacity .6s,filter .7s}.hero-word-feel{transition-delay:70ms}.outline-word{transition-delay:140ms}.hero-star{transition:opacity .5s,filter .5s}.hero-grid{transition:opacity .8s}
  .hero[data-mode=entering] .hero-word,.hero[data-mode=game] .hero-word{opacity:0;filter:blur(14px);transform:translate3d(-65px,-36px,0) rotate(-5deg) scale(.94)}.hero[data-mode=entering] .hero-word-feel,.hero[data-mode=game] .hero-word-feel{transform:translate3d(-105px,12px,0) rotate(-3deg) scale(.9)}.hero[data-mode=entering] .outline-word,.hero[data-mode=game] .outline-word{transform:translate3d(-145px,60px,0) rotate(3deg) scale(.88)}
  .hero[data-mode=entering] :is(.hero-hello,.hero-description,.hero-links,.hero-bottom,.hero-eyebrow,.hero-marquee),.hero[data-mode=game] :is(.hero-hello,.hero-description,.hero-links,.hero-bottom,.hero-eyebrow,.hero-marquee){opacity:0;filter:blur(8px);transform:translateY(-20px);pointer-events:none}.hero[data-mode=entering] .hero-star,.hero[data-mode=game] .hero-star{opacity:0;filter:blur(12px)}.hero[data-mode=game] .hero-content{visibility:hidden}.hero[data-mode=entering] .hero-grid,.hero[data-mode=game] .hero-grid{opacity:.3}
  .hero[data-mode=exiting] .hero-word{transition-delay:.36s}.hero[data-mode=exiting] .hero-word-feel{transition-delay:.43s}.hero[data-mode=exiting] .outline-word{transition-delay:.5s}.hero[data-mode=exiting] :is(.hero-hello,.hero-description,.hero-links,.hero-bottom,.hero-eyebrow,.hero-marquee){transition-delay:.55s}
  .hero-game{color:#eaf0df;color-scheme:dark;position:absolute;inset:0;z-index:6;padding:22px 40px 30px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(24px);filter:blur(8px);transition:opacity .45s ease,transform .7s cubic-bezier(.22,1,.36,1),filter .6s ease;isolation:isolate}.hero-game-toolbar{width:min(1120px,100%);margin:0 auto 14px;display:flex;justify-content:space-between;align-items:center;gap:14px}.hero-track{display:flex;min-width:0;gap:12px;align-items:center;font:500 12px/1.5 var(--font-display);letter-spacing:.15em;color:#d2e6dd}.hero-track b{font-weight:400;color:#57766c;margin-inline:8px}.hero-track>span:last-child{min-width:0}.hero-track small{display:block;font-size:8px;font-weight:400;letter-spacing:.12em;line-height:1.7;overflow-wrap:anywhere;color:#7c9b91;margin-top:3px}.hero-track-dot{flex:none;width:7px;height:7px;background:var(--stage-accent,#b9e3c4);border-radius:50%;box-shadow:0 0 18px color-mix(in srgb,var(--stage-accent,#b9e3c4) 50%,transparent)}.hero-exit{display:flex;flex:none;align-items:center;gap:12px;border:1px solid #9fbcb333;background:#b6dacc0a;border-radius:30px;padding:10px 17px;color:#c4d7ce;font-size:11px;white-space:nowrap;transition:background .2s,border-color .2s}.hero-exit:hover{background:#b6dacc1a;border-color:#b6dacc77}.hero-exit>span{font-size:17px}.hero-exit kbd{font:8px var(--font-display);color:#68857b;border-left:1px solid #9fbcb333;padding-left:10px}.hero-game-body{width:min(900px,100%);margin-inline:auto;transform:perspective(1000px) rotateX(12deg) translateY(35px) scale(.86);transform-origin:50% 75%;transition:transform .9s cubic-bezier(.16,1,.3,1)}.hero-game-watermark{position:absolute;top:45%;left:15px;writing-mode:vertical-rl;font:500 10px var(--font-display);letter-spacing:.3em;color:#a5ccb933;pointer-events:none}
  .hero[data-mode=entering] .hero-game,.hero[data-mode=game] .hero-game{visibility:visible;pointer-events:auto;opacity:1;filter:none;transform:none;transition-delay:.5s}.hero[data-mode=entering] .hero-game-body,.hero[data-mode=game] .hero-game-body{transform:none;transition-delay:.45s}.hero[data-mode=exiting] .hero-game{visibility:visible;transform:translateY(35px);filter:blur(12px);transition-duration:.4s}.hero[data-mode=exiting] .hero-game-body{transform:perspective(1000px) rotateX(-10deg) scale(.82);transition-duration:.55s}.hero[data-round-state=playing] .hero-track-dot{animation:stage-pulse var(--stage-pulse-duration,.8s) ease-in-out infinite}
  .hero-transition{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}.hero-transition i{position:absolute;width:1px;height:65%;left:calc(30% + var(--lane)*13.333%);bottom:13%;background:linear-gradient(transparent,#b4f6e8aa,transparent);transform:scaleY(0);opacity:0;transform-origin:50% 100%;box-shadow:0 0 12px #a8e6dc66}.hero-transition i:nth-child(1){--lane:0}.hero-transition i:nth-child(2){--lane:1}.hero-transition i:nth-child(3){--lane:2;background:linear-gradient(transparent,#f4b49caa,transparent)}.hero-transition i:nth-child(4){--lane:3;background:linear-gradient(transparent,#f4b49caa,transparent)}.hero-transition>span{position:absolute;left:50%;top:45%;width:65vmin;aspect-ratio:1;border:1px solid #b9e3c422;border-radius:50%;transform:translate(-50%,-50%) scale(.2);opacity:0}.hero[data-mode=entering] .hero-transition i{animation:lane-unfold 1.15s cubic-bezier(.22,1,.36,1) both;animation-delay:calc(var(--lane)*.05s)}.hero[data-mode=entering] .hero-transition>span{animation:stage-ripple 1.2s ease-out both}.hero[data-mode=exiting] .hero-transition i{animation:lane-unfold .9s ease-in reverse both}.hero[data-mode=exiting] .hero-transition>span{animation:stage-ripple 1s ease-in reverse both}
