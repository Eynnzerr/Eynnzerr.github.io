---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeEntry from '../../components/LifeEntry.astro';
import { getLifeEntries, lifeLabels, type LifeKind } from '../../lib/life';
const entries = getLifeEntries();
const kinds = Object.entries(lifeLabels) as [LifeKind, string][];
---

<BaseLayout title="生活" description="代码之外的短想法、照片、声音与生活记录。" class="life-page">
  <div class="container life-shell">
    <header class="life-heading">
      <div><p class="eyebrow">OFF THE CLOCK</p><h1>生活的<br /><span>另一面。</span><svg width="98" height="55" viewBox="0 0 98 55" fill="none" aria-hidden="true"><path d="M4 36C19 19 42 18 57 25c11 5 9 16-1 19-13 5-31-1-37-10S24 11 43 8c22-3 40 3 51 11M80 7l14 12-17 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></h1><p class="life-lead">短一点的想法，长一点的回忆。<br />还有屏幕之外，那些值得留下的片段。</p></div>
      <div class="life-margin" aria-hidden="true"><span class="margin-word">LIFE<br />IN BETWEEN.</span><div class="life-disc"><span></span></div><p>SOME WORDS.<br />SOME FRAMES.<br />SOME SOUND.</p></div>
    </header>

    {entries.length > 0 ? <>
    <div class="life-toolbar">
      <nav class="life-filters" aria-label="按生活内容类型筛选">
        <button type="button" data-life-filter="all" aria-pressed="true">全部<span>{entries.length}</span></button>
        {kinds.map(([kind, label]) => <button type="button" data-life-filter={kind} aria-pressed="false">{label}<span>{entries.filter((entry) => entry.type === kind).length}</span></button>)}
      </nav>
      <p class="life-count" data-life-count aria-live="polite">{entries.length} 则记录</p>
    </div>
    <section class="life-timeline" aria-label="生活混合时间线">
      {entries.map((entry, index) => <LifeEntry entry={entry} index={index} />)}
    </section>
    <p class="life-empty" data-life-empty hidden>这个分类暂时还没有内容。</p>
    <div class="life-end"><span></span><p>TO BE CONTINUED<span>生活还在继续。</span></p><span></span></div>
    </> : <section class="life-blank" aria-label="生活记录待续">
      <span class="life-blank-mark" aria-hidden="true">✳</span>
      <div><p class="eyebrow">ROOM FOR A LITTLE MORE</p><h2>留一点空白，给生活。</h2><p>随笔、照片和视频，慢慢放在这里。</p></div>
    </section>}
  </div>
</BaseLayout>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-life-filter]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-life-entry]')];

  /** Filter the mixed timeline and stop an embedded video when its entry is hidden. */
  function filterLife(kind: string, updateAddress = false) {
    let visible = 0;
    filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.lifeFilter === kind)));
    entries.forEach((entry) => {
      entry.hidden = kind !== 'all' && entry.dataset.kind !== kind;
      if (!entry.hidden) visible += 1;
      if (entry.hidden) {
        const player = entry.querySelector<HTMLElement>('[data-video-player]');
        if (player?.firstElementChild) {
          player.replaceChildren();
          player.hidden = true;
          entry.querySelector<HTMLButtonElement>('[data-video-play]')!.hidden = false;
        }
      }
    });
    document.querySelector('[data-life-count]')!.textContent = `${visible} 则记录`;
    document.querySelector<HTMLElement>('[data-life-empty]')!.hidden = visible > 0;
    if (updateAddress) {
      const url = new URL(location.href);
      if (kind === 'all') url.searchParams.delete('type'); else url.searchParams.set('type', kind);
      history.replaceState(null, '', url);
    }
  }

  filters.forEach((button) => button.addEventListener('click', () => filterLife(button.dataset.lifeFilter!, true)));
  const initial = new URLSearchParams(location.search).get('type');
  if (initial && filters.some((button) => button.dataset.lifeFilter === initial)) filterLife(initial);
</script>

<style>
  .life-shell{max-width:1120px}.life-heading{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:72px 0 57px}.life-heading .eyebrow{margin-bottom:23px}.life-heading h1{position:relative;font-size:clamp(54px,7.5vw,90px);line-height:1.18;letter-spacing:-.065em;font-weight:500;margin:0 0 29px}.life-heading h1>span{color:var(--accent)}.life-heading h1 svg{display:inline-block;width:85px;margin:0 0 8px 16px;color:var(--accent);transform:rotate(-9deg)}.life-lead{font-size:13px;line-height:1.95;color:var(--muted);margin:0}.life-margin{position:relative;display:flex;flex-direction:column;gap:27px;padding-right:50px;min-width:240px}.margin-word{font:400 13px/1.35 var(--font-display);letter-spacing:.035em;transform:rotate(7deg);margin-left:28px;color:var(--muted)}.life-disc{position:relative;width:148px;height:148px;display:grid;place-items:center;border-radius:50%;background:repeating-radial-gradient(circle at center,#213a3a 0,#213a3a 2px,#314e4b 3px,#213a3a 4px);transform:rotate(-15deg);box-shadow:8px 12px 18px #193b3611}.life-disc::after{content:'';position:absolute;width:100%;height:100%;border-radius:50%;background:conic-gradient(transparent 0deg,#bfdad023 45deg,transparent 85deg,transparent 180deg,#bfdad02e 230deg,transparent 280deg)}.life-disc span{width:49px;height:49px;border:20px solid #db9275;border-radius:50%;background:var(--bg);z-index:1}.life-margin>p{font:9px/1.6 var(--font-display);letter-spacing:.08em;margin:0 0 0 56px;color:var(--muted)}
  .life-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:17px 0}.life-filters{display:flex;gap:8px;flex-wrap:wrap}.life-filters button{display:flex;align-items:center;gap:11px;padding:7px 14px;border:0;background:none;color:var(--muted);font-size:12px;border-radius:5px;transition:background .2s,color .2s}.life-filters button:hover{background:var(--surface-alt);color:var(--ink)}.life-filters button[aria-pressed=true]{background:var(--ink);color:var(--bg)}.life-filters button>span{font:9px var(--font-display);opacity:.6}.life-count{font:10px var(--font-display);color:var(--muted);white-space:nowrap;margin:0}.life-empty{padding:60px 0;color:var(--muted);text-align:center;font-size:14px}.life-empty[hidden]{display:none}.life-end{display:flex;align-items:center;justify-content:center;gap:28px;margin:64px 0 80px}.life-end>span{width:64px;height:1px;background:var(--line)}.life-end p{font:9px/1.6 var(--font-display);letter-spacing:.13em;text-align:center;color:var(--muted);margin:0}.life-end p span{display:block;font:11px var(--font-body);letter-spacing:0;margin-top:9px}
  .life-blank{display:flex;align-items:center;gap:38px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:64px 4%;margin-bottom:85px}.life-blank-mark{font-size:72px;line-height:1;color:var(--accent);font-weight:300}.life-blank .eyebrow{font-size:9px;margin:0 0 16px;color:var(--muted)}.life-blank h2{font-size:clamp(23px,3vw,32px);font-weight:500;letter-spacing:-.04em;margin:0 0 14px}.life-blank div>p:last-child{font-size:12px;line-height:1.9;color:var(--muted);margin:0}
  @media(max-width:900px){.life-margin{padding-right:10px;min-width:190px}.life-heading{padding-top:60px}.life-heading h1{font-size:70px}.life-heading h1 svg{width:65px}}
  @media(max-width:600px){.life-blank{gap:22px;padding:42px 0;margin-bottom:55px}.life-blank-mark{font-size:47px}.life-blank .eyebrow{font-size:8px}.life-blank h2{font-size:21px}.life-blank div>p:last-child{font-size:11px}.life-heading{padding:45px 0 34px;align-items:flex-end;gap:10px}.life-heading .eyebrow{font-size:9px;margin-bottom:17px}.life-heading h1{font-size:53px;margin-bottom:22px}.life-heading h1 svg{width:46px;height:30px;margin:0 0 4px 6px}.life-lead{font-size:11px;max-width:260px}.life-margin{min-width:0;width:60px;align-self:flex-start;padding:64px 0 0;gap:22px;position:absolute;right:25px;pointer-events:none}.margin-word,.life-margin>p{display:none}.life-disc{width:60px;height:60px;box-shadow:3px 6px 9px #193b3611}.life-disc span{width:22px;height:22px;border-width:9px}.life-toolbar{gap:5px;padding:12px 0}.life-filters{gap:1px}.life-filters button{font-size:11px;gap:6px;padding:7px 9px}.life-count{display:none}.life-end{gap:20px;margin:48px 0 58px}.life-end>span{width:35px}}
</style>
