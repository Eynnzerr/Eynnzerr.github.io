---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';
const projects = getProjects();
const categories = ['全部', ...new Set(projects.map((project) => project.category))];
---
<BaseLayout title="作品" description="Eynnzerr 的软件作品：跨平台客户端、创作工具与游戏相关开发。">
  <section class="page-intro container"><span class="eyebrow">IDEAS, MADE TANGIBLE</span><h1 class="display-title">Things I've<br /><span>built.</span><sup>{String(projects.length).padStart(2, '0')}</sup></h1><div class="project-intro-bottom"><p>从一个自己的需求出发，<br />做一些也许对别人有用的东西。</p><span class="project-note">SELECTED WORK<br />CLIENT / WEB / TOOLS</span></div></section>
  <section class="gallery container"><div class="gallery-toolbar"><div class="gallery-filters" role="group" aria-label="筛选作品">{categories.map((category,index) => <button data-filter={category} class:list={{selected:index === 0}} aria-pressed={index===0}>{category}</button>)}</div><span id="project-count" aria-live="polite">{projects.length} 件作品</span></div>
    {projects.map((project, index) => (
      <article id={project.id} class={`project ${project.visual}`} data-category={project.category}>
        <div class="project-visual">
          <span class="visual-index">{String(index + 1).padStart(2, '0')} / {project.category}</span>
          {project.visual === 'phones' ? (
            <div class="phone-pair">
              <img src={project.image} alt={project.imageAlt || `${project.title} 应用主界面`} loading="lazy" width="1080" height="2400" />
              <img src={project.secondaryImage} alt={project.secondaryImageAlt || `${project.title} 功能界面`} loading="lazy" width="1080" height="2400" />
            </div>
          ) : <img class="wide-shot" src={project.image} alt={project.imageAlt || `${project.title} 项目界面`} loading="lazy" width="1600" height="1000" />}
          <span class="visual-word" aria-hidden="true">{project.visualLabel || (project.id === 'bandori' ? 'CONNECT.' : project.id === 'blue-fish' ? 'CREATE.' : 'PLAY.')}</span>
        </div>
        <div class="project-info">
          <span class="project-status"><i></i>{project.status}</span>
          <h2>{project.title}</h2>
          <h3>{project.subtitle}</h3>
          <p>{project.description}</p>
          <div class="stack">{project.stack.map((item) => <span>{item}</span>)}</div>
          <div class="platforms">{project.platforms}</div>
          <div class="project-actions">
            {project.demo && <a class="button" href={project.demo} target="_blank" rel="noreferrer">在线体验 ↗</a>}
            {project.download && <a class="button" href={project.download} target="_blank" rel="noreferrer">获取应用 ↗</a>}
            <a class="text-link" href={project.source} target="_blank" rel="noreferrer">源码 ↗</a>
            {project.video && <a class="text-link" href={project.video} target="_blank" rel="noreferrer">演示 ↗</a>}
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="more-projects container"><span class="eyebrow">STILL EXPLORING</span><p>还有一些实验，正在生长。</p><a class="text-link" href="https://github.com/Eynnzerr?tab=repositories" target="_blank" rel="noreferrer">到 GitHub 看看 ↗</a></section>
</BaseLayout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const projects = document.querySelectorAll<HTMLElement>('.project[data-category]');
  /** Apply a gallery category and announce the visible product count. */
  function filterProjects(filter: string): void {
    let count = 0;
    for (const item of projects) { item.hidden = filter !== '全部' && item.dataset.category !== filter; if (!item.hidden) count++; }
    for (const button of filters) { const active = button.dataset.filter === filter; button.classList.toggle('selected', active); button.setAttribute('aria-pressed', String(active)); }
    document.querySelector('#project-count')!.textContent = `${count} 件作品`;
  }
  for (const button of filters) button.addEventListener('click', () => filterProjects(button.dataset.filter!));
</script>
<style>
  #yuuka-talk .project-visual{background:#dde1ef}#markfun .project-visual{background:#e1e5d8}#apex-box .project-visual{background:#e6dcd7}#apex-box .visual-word{font-size:clamp(22px,2.5vw,32px)}
  .display-title>span{color:var(--accent)}.display-title>sup{font:13px var(--font-display);letter-spacing:.08em;vertical-align:top;margin:17px 0 0 25px;display:inline-block;color:var(--muted)}.project-intro-bottom{display:flex;justify-content:space-between;gap:30px;align-items:end}.project-intro-bottom p{font-size:15px;line-height:1.9;margin:0}.project-note{font:10px/1.8 var(--font-display);letter-spacing:.1em;color:var(--muted);text-align:right}.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:12px 0 20px}.gallery-filters{display:flex;gap:8px;flex-wrap:wrap}.gallery-filters button{border:1px solid transparent;border-radius:30px;background:none;color:var(--muted);padding:7px 18px;font-size:12px}.gallery-filters button.selected{border-color:var(--ink);background:var(--ink);color:var(--bg)}#project-count{white-space:nowrap;font-size:11px;color:var(--muted)}.project{display:grid;grid-template-columns:1.1fr 1fr;gap:65px;padding:60px 0;border-bottom:1px solid var(--line);align-items:center;scroll-margin-top:25px}.project[hidden]{display:none}.project-visual{height:400px;overflow:hidden;background:#d9ddd4;position:relative}.visual-index{position:absolute;top:22px;left:25px;font:10px var(--font-display);letter-spacing:.09em;color:#3d5144;z-index:2}.visual-word{position:absolute;left:24px;bottom:20px;font:500 35px var(--font-display);letter-spacing:-.045em;color:#2a42363d}.phone-pair{display:flex;justify-content:center;gap:18px;padding-top:65px;transform:rotate(-7deg)}.phone-pair>img{width:160px;height:355px;object-fit:cover;object-position:top;border:5px solid #22342d;border-radius:22px;box-shadow:10px 18px 22px #2d443d29}.phone-pair>img:nth-child(2){margin-top:45px;transform:rotate(13deg)}.desktop .project-visual{background:#d4e4e5}.wide-shot{position:absolute;width:95%;max-width:none;top:75px;left:12%;border:5px solid #f9f8f3;border-radius:7px;box-shadow:12px 18px 25px #23393220;transform:rotate(-6deg)}.banner .project-visual{background:#e3dbce}.banner .wide-shot{width:89%;left:5.5%;top:105px;border:0;transform:rotate(-3deg);border-radius:0}.project-status{font-size:10px;color:var(--accent);display:flex;gap:7px;align-items:center}.project-status i{width:5px;height:5px;border-radius:50%;background:currentColor}.project-info h2{font:500 33px/1.2 var(--font-display);letter-spacing:-.05em;margin:18px 0 14px}.project-info h3{font-size:15px;line-height:1.7;font-weight:500;margin-bottom:18px}.project-info>p{font-size:13px;color:var(--muted);line-height:2}.stack{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.stack span{border:1px solid var(--line);padding:3px 9px;border-radius:4px;font:10px/1.8 var(--font-display);color:var(--muted)}.platforms{font:10px var(--font-display);color:var(--muted);margin:15px 0 27px}.project-actions{display:flex;gap:24px;align-items:center}.project-actions .button{padding:10px 19px;font-size:12px}.project-actions .text-link{font-size:12px;gap:10px}.more-projects{padding:65px 0 85px;text-align:center;display:flex;flex-direction:column;align-items:center}.more-projects p{font-size:26px;margin:17px 0 25px}@media(max-width:900px){.project{gap:35px}.project-visual{height:340px}.phone-pair{gap:9px}.phone-pair>img{width:130px;height:300px}.project-info h2{font-size:28px}.project-actions{gap:15px}.wide-shot{top:110px}}@media(max-width:600px){.project-note{display:none}.project{grid-template-columns:1fr;gap:26px;padding:35px 0}.project-visual{height:330px}.phone-pair>img{width:140px;height:320px}.project-info h2{font-size:30px}.project-actions{gap:24px}.gallery-filters button{padding:6px 14px}.gallery-toolbar{gap:10px;align-items:flex-start}.gallery-filters{gap:5px}.gallery-filters button{padding:6px 10px}.project-intro-bottom p{font-size:14px}.more-projects p{font-size:22px}.visual-word{font-size:32px}}
</style>
