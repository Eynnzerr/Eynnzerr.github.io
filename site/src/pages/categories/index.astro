---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories } from '../../lib/posts';
const categories = getCategories(await getPosts());
---
<BaseLayout title="分类" description="从客户端、跨平台到计算机基础，按方向阅读。" class="blog-page"><div class="category-shell"><a class="back" href="/blog/">← 返回博客</a><p class="eyebrow">A FEW THINGS I'M LEARNING</p><h1>持续探索的<br /><span>几个方向。</span></h1><div class="category-list">{categories.map((category, index) => <a href={`/categories/${category.slug}/`} class:list={{ nested: category.path.length > 1 }}><span class="index">{category.path.length > 1 ? '↳' : String(index + 1).padStart(2, '0')}</span><h2>{category.name}</h2><span class="count">{category.posts.length} 篇</span><span class="arrow" aria-hidden="true">↗</span></a>)}</div><p class="taxonomy-link"><a href="/tags/">也可以，从标签开始 →</a></p></div></BaseLayout>
<style>.category-shell{max-width:1040px;padding:65px 30px 85px;margin:auto;color:var(--ink)}.back{font-size:11px;color:var(--accent);text-decoration:none}.eyebrow{font:10px monospace;letter-spacing:.16em;color:var(--muted);margin:45px 0 20px}h1{font-size:clamp(40px,6vw,66px);font-weight:550;letter-spacing:-.055em;line-height:1.2;margin:0 0 50px}h1 span{color:var(--muted)}.category-list{border-top:1px solid var(--line)}.category-list>a{display:grid;grid-template-columns:50px 1fr 55px 30px;gap:15px;align-items:center;padding:28px 15px 28px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);transition:background .2s}.category-list>a:hover{background:#e7eddf}.index{font:10px monospace;color:var(--muted)}h2{margin:0;font-size:25px;font-weight:500;letter-spacing:-.02em}.count{font-size:11px;color:var(--muted)}.arrow{font-size:24px;color:var(--muted)}.category-list>.nested{padding-left:42px} .nested h2{font-size:20px}.taxonomy-link{margin:32px 0;font-size:12px}.taxonomy-link a{text-decoration:none;color:var(--muted)}@media(max-width:600px){.category-shell{padding:42px 22px 60px}.category-list>a{grid-template-columns:25px 1fr 36px 20px;gap:10px}.category-list h2{font-size:21px}.category-list>.nested{padding-left:20px}}
</style>
