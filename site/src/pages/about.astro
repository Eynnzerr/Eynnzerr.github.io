---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityHeatmap from '../components/ActivityHeatmap.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
const tools = [
  ['01', 'Client & Cross-platform', 'Kotlin · Compose Multiplatform · Swift · Flutter'],
  ['02', 'A little beyond', 'TypeScript · React · Python · C++'],
  ['03', 'Outside of code', 'Melodic Dubstep · Melodic Bass · 音乐游戏'],
];
---
<BaseLayout title="关于我" description="认识 Eynnzerr：写代码，听音乐，保持好奇。这里有我的经历、技术与热爱，以及每天的一点点探索。">
  <section class="about-hero container">
    <div class="about-intro"><span class="eyebrow">THE PERSON BEHIND THE PIXELS</span><h1>Hi, I'm<br /><span>Eynnzerr.</span><span class="asterisk" aria-hidden="true">✳</span></h1><p class="about-lead">写代码的人，<br />也是认真听音乐的人。</p><p class="about-text">主业关注移动端与客户端开发，喜欢 Kotlin，也喜欢探索跨平台的可能。代码之外，常常在听电子音乐，或者打一会儿音游。</p><a class="text-link" href="#contact">打个招呼 ↗</a></div>
    <figure class="portrait"><img src="/images/avatar.webp" alt="Eynnzerr 在电子音乐现场，戴着墨镜微笑" width="800" height="800" fetchpriority="high"/><figcaption><span>A MOMENT, OFFLINE.</span><span>这是我。 ↗</span></figcaption><span class="portrait-tape" aria-hidden="true"></span></figure>
  </section>

  <section class="about-details container"><div><span class="eyebrow">A FEW MORE THINGS</span><h2>工具与热爱，<br />组成现在的我。</h2><p>技术栈会变化。<br />好奇心希望一直都在。</p></div><div class="tool-list">{tools.map(([number, title, detail]) => <div class="tool-row"><span>{number}</span><div><h3>{title}</h3><p>{detail}</p></div></div>)}</div></section>

  <ExperienceTimeline />

  <section class="activity-section container"><div class="section-heading"><div><span class="eyebrow">SMALL STEPS, OVER TIME</span><h2>每天的一点点。</h2><p>留下代码，也留下探索的痕迹。</p></div><span class="activity-note"><i></i> 真实记录 · 每日汇总</span></div><ActivityHeatmap kind="github"/><ActivityHeatmap kind="codex"/></section>

  <section class="contact-section container" id="contact"><div><span class="eyebrow">SAY HELLO</span><h2>聊代码，<br />也聊别的。</h2></div><div class="contact-links"><a href="https://github.com/Eynnzerr" target="_blank" rel="noreferrer"><span>GitHub</span><small>@Eynnzerr</small><b>↗</b></a><a href="mailto:eynnzerr@gmail.com"><span>Email</span><small>eynnzerr@gmail.com</small><b>↗</b></a><button class="qq-copy" data-qq="809204291"><span>QQ</span><small>809204291</small><b class="copy-label">复制 ↗</b></button><a href="https://space.bilibili.com/21157246" target="_blank" rel="noreferrer"><span>Bilibili</span><small>@Eynnzerr</small><b>↗</b></a><p class="copy-result" aria-live="polite"></p></div></section>
</BaseLayout>
<script>
  /** Copy the public contact number and announce success without opening QQ. */
  async function copyQQ(): Promise<void> {
    const button = document.querySelector<HTMLButtonElement>('.qq-copy');
    const message = document.querySelector<HTMLElement>('.copy-result');
    if (!button || !message) return;
    try { await navigator.clipboard.writeText(button.dataset.qq!); message.textContent = 'QQ 号码已复制。'; }
    catch { message.textContent = 'QQ：809204291，可选中号码复制。'; }
  }
  document.querySelector('.qq-copy')?.addEventListener('click', copyQQ);
</script>
<style>
  .about-hero{padding:83px 0 95px;display:grid;grid-template-columns:1.1fr 1fr;gap:100px;align-items:center}.about-intro h1{font:500 clamp(65px,7vw,104px)/1.08 var(--font-display);letter-spacing:-.07em;margin:30px 0;position:relative;width:fit-content}.about-intro h1>span:first-child{color:var(--accent)}.asterisk{font-size:55px;position:absolute;top:0;right:-75px;color:#bf7957}.about-lead{font-size:23px;font-weight:500;line-height:1.6;letter-spacing:-.03em;margin-bottom:18px}.about-text{max-width:425px;font-size:13px;color:var(--muted);line-height:2}.about-intro .text-link{margin-top:15px}.portrait{margin:0;padding:13px;background:var(--surface);transform:rotate(4deg);box-shadow:10px 15px 0 var(--surface-alt);position:relative}.portrait img{width:100%;display:block;aspect-ratio:1;object-fit:cover;filter:saturate(.8)}.portrait figcaption{display:flex;justify-content:space-between;font:10px var(--font-display);letter-spacing:.1em;padding:20px 8px 10px;color:var(--muted)}.portrait-tape{position:absolute;top:-15px;left:36%;width:110px;height:34px;background:#c5c9b999;transform:rotate(-7deg);backdrop-filter:blur(4px)}.about-details{border-top:1px solid var(--line);padding:70px 0 85px;display:grid;grid-template-columns:1fr 1.25fr;gap:100px}.about-details h2,.contact-section h2{font-size:37px;line-height:1.5;font-weight:500;margin:25px 0 20px}.about-details>div>p{font-size:13px;color:var(--muted)}.tool-row{border-bottom:1px solid var(--line);padding:22px 0;display:flex;gap:26px}.tool-row:first-child{padding-top:0}.tool-row>span{font:11px var(--font-display);color:var(--muted);padding-top:5px}.tool-row h3{font:500 21px var(--font-display);margin:0 0 12px;letter-spacing:-.02em}.tool-row p{font-size:12px;color:var(--muted);margin:0}.activity-section{padding:30px 0 75px}.activity-note{font-size:11px;color:var(--muted);display:flex;gap:8px;align-items:center}.activity-note i{width:5px;height:5px;border-radius:50%;background:var(--accent)}.contact-section{padding:65px 0 105px;display:grid;grid-template-columns:1fr 1.25fr;gap:100px;border-top:1px solid var(--line)}.contact-links>a,.contact-links>button{display:flex;align-items:center;gap:25px;padding:20px 0;border:0;border-bottom:1px solid var(--line);width:100%;background:none;text-align:left;color:var(--ink);transition:padding .2s}.contact-links>a:hover,.contact-links>button:hover{padding-inline:10px;color:var(--accent)}.contact-links span{font:500 23px var(--font-display);width:105px}.contact-links small{font:12px var(--font-display);color:var(--muted)}.contact-links b{margin-left:auto;font-size:19px;font-weight:400}.contact-links .copy-label{font-size:12px}.copy-result{font-size:12px;color:var(--accent);margin:15px 0 0;min-height:22px}@media(max-width:900px){.about-hero{gap:50px}.about-details,.contact-section{gap:50px}.asterisk{font-size:40px;right:-50px}.about-intro h1{font-size:70px}.activity-note{display:none}}@media(max-width:600px){.about-hero{grid-template-columns:1fr;padding:50px 0 65px;gap:40px}.about-intro h1{font-size:clamp(60px,20vw,76px);margin-block:26px}.asterisk{right:0;letter-spacing:normal}.about-lead{font-size:23px}.portrait{width:85%;margin:0 auto}.about-details,.contact-section{grid-template-columns:1fr;gap:24px;padding:50px 0}.about-details h2,.contact-section h2{font-size:31px}.tool-row h3{font-size:20px}.activity-section{padding:15px 0 40px}.contact-links>a,.contact-links>button{gap:10px}.contact-links span{font-size:21px;width:80px}.contact-links small{font-size:11px}}
</style>
