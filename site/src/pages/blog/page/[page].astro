---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { getPosts, PAGE_SIZE } from '../../../lib/posts';

/** Build the new blog index pages while legacy pagination remains available. */
export async function getStaticPaths() {
  const posts = await getPosts();
  const count = Math.ceil(posts.length / PAGE_SIZE);
  return Array.from({ length: count }, (_, index) => ({ params: { page: String(index + 1) }, props: { page: index + 1, count, posts: posts.slice(index * PAGE_SIZE, (index + 1) * PAGE_SIZE) } }));
}
/** A single page of the chronological article list. */
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, count, posts } = Astro.props;
---
<BaseLayout title={`博客 · 第 ${page} 页`} class="blog-page">
  <div class="listing-shell"><a href="/blog/" class="back-link">← 返回博客</a><p class="eyebrow">NOTES / {String(page).padStart(2, '0')}</p><h1>更早的记录。</h1><ArticleList posts={posts} /><nav class="pagination" aria-label="文章分页">{page > 1 ? <a href={page === 2 ? '/blog/' : `/blog/page/${page - 1}/`}>← 上一页</a> : <span />}<span>{page} / {count}</span>{page < count ? <a href={`/blog/page/${page + 1}/`}>下一页 →</a> : <span />}</nav></div>
</BaseLayout>
<style>.listing-shell{max-width:1040px;margin:auto;padding:65px 30px 80px}.back-link{font-size:12px;color:var(--accent);text-decoration:none}.eyebrow{font:10px monospace;letter-spacing:.15em;color:var(--muted);margin:45px 0 18px}h1{font-size:clamp(38px,5vw,60px);font-weight:550;letter-spacing:-.05em;color:var(--ink);margin:0 0 45px}.pagination{display:flex;justify-content:space-between;padding:30px 0;font:12px monospace;color:var(--muted)}.pagination a{color:var(--accent);text-decoration:none}</style>
