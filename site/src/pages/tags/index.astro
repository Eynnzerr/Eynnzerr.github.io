---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';
const tags = getTags(await getPosts());
---
<BaseLayout title="标签" description="沿着一个关键词，读下去。" class="blog-page"><div class="taxonomy-shell"><a class="back" href="/blog/">← 返回博客</a><p class="eyebrow">FOLLOW YOUR CURIOSITY / {tags.length} TOPICS</p><h1>从一个词，<br /><span>开始探索。</span></h1><p class="intro">语言、工具、架构，和它们之间的联系。</p><div class="tag-grid">{tags.map((tag, index) => <a href={`/tags/${tag.slug}/`}><span class="number">{String(index + 1).padStart(2, '0')}</span><h2>{tag.name}</h2><span class="tag-count">{tag.posts.length} 篇 <b aria-hidden="true">↗</b></span></a>)}</div><nav><a href="/categories/">按分类浏览 →</a><a href="/archives/">按时间浏览 →</a></nav></div></BaseLayout>
<style>.taxonomy-shell{max-width:1060px;margin:auto;padding:65px 35px 85px;color:var(--ink)}.back{font-size:11px;text-decoration:none;color:var(--accent)}.eyebrow{font:10px var(--font-mono,monospace);letter-spacing:.15em;color:var(--muted);margin:45px 0 20px}h1{font-weight:550;font-size:clamp(42px,6vw,67px);line-height:1.2;letter-spacing:-.055em;margin:0}h1 span{color:var(--muted)}.intro{color:var(--muted);font-size:13px;margin:25px 0 45px}.tag-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.tag-grid>a{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:23px 24px 20px;display:flex;flex-direction:column;gap:15px;text-decoration:none;transition:background .2s}.tag-grid>a:hover{background:#e3ecdb}.number{font:10px monospace;color:var(--muted)}.tag-grid h2{font-size:21px;font-weight:500;letter-spacing:-.025em;color:var(--ink);margin:0}.tag-count{font-size:10px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}.tag-count b{font-size:20px;font-weight:400;color:var(--accent)}.taxonomy-shell>nav{display:flex;gap:30px;padding:30px 0;font-size:12px}.taxonomy-shell>nav a{color:var(--muted);text-decoration:none}@media(max-width:680px){.taxonomy-shell{padding:42px 22px 60px}.tag-grid{grid-template-columns:repeat(2,1fr)}.tag-grid>a{padding:18px 15px}.tag-grid h2{font-size:17px}.eyebrow{font-size:9px}}
</style>
