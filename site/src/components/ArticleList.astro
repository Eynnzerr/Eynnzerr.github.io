---
import { formatCount, formatDate, taxonomySlug, type BlogPost } from '../lib/posts';

/** Editorial article list shared by blog, archive, and taxonomy pages. */
interface Props {
  /** Articles in the caller's chosen order. */
  posts: BlogPost[];
  /** Omit excerpts when embedded in a shorter overview. */
  compact?: boolean;
}
const { posts, compact = false } = Astro.props;
---

<div class:list={['article-list', { compact }]}>
  {posts.map((post, index) => (
    <article class="article-row">
      <div class="article-date">
        <span class="row-number">{String(index + 1).padStart(2, '0')}</span>
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      </div>
      <div class="article-summary">
        <div class="article-topic">{post.categories.join(' / ') || '随笔'}</div>
        <h2><a href={post.url}>{post.title}<span aria-hidden="true">↗</span></a></h2>
        {!compact && <p>{post.description}</p>}
        <div class="article-details">
          <span>{formatCount(post.wordCount)} 字</span><span>{post.readingMinutes} 分钟</span>
          {post.tags.slice(0, 3).map((tag) => <a href={`/tags/${taxonomySlug(tag)}/`}>#{tag}</a>)}
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .article-list{border-top:1px solid var(--line)}
  .article-row{display:grid;grid-template-columns:128px 1fr;gap:24px;padding:34px 0 36px;border-bottom:1px solid var(--line)}
  .article-date{display:flex;flex-direction:column;gap:15px;font-family:var(--font-mono,monospace);font-size:11px;color:var(--muted);padding-top:5px;letter-spacing:.035em}
  .row-number{font-size:12px;color:var(--muted)}
  .article-topic{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.055em;color:var(--accent);margin-bottom:9px}
  h2{font-size:clamp(20px,2.15vw,29px);font-weight:600;line-height:1.5;letter-spacing:-.04em;margin:0}
  h2 a{color:var(--ink);display:flex;align-items:baseline;justify-content:space-between;gap:20px;text-decoration:none;transition:color .2s}
  h2 a:hover{color:#0b9389}
  h2 a span{font-size:25px;font-weight:400;transition:transform .2s}
  h2 a:hover span{transform:translate(3px,-3px)}
  .article-summary>p{font-size:14px;line-height:1.95;color:var(--muted);max-width:680px;margin:12px 0 16px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .article-details{display:flex;flex-wrap:wrap;gap:7px 17px;font-size:11px;line-height:1.6;color:var(--muted);margin-top:14px}
  .article-details a{text-decoration:none;color:var(--muted)}
  .article-details a:hover{text-decoration:underline;color:var(--accent)}
  .compact .article-row{padding:24px 0}.compact h2{font-size:22px}
  @media(max-width:640px){.article-row{grid-template-columns:1fr;gap:12px;padding:25px 0}.article-date{flex-direction:row;gap:12px}.row-number{display:none}h2{font-size:22px}.article-summary>p{font-size:13px}.article-details{gap:6px 12px}}
</style>
