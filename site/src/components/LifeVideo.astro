---
/** A Bilibili video cover that creates its player only after an explicit click. */
interface Props {
  /** Public Bilibili video identifier. */
  bvid: string;
  /** Accessible video title used by the play button and embedded player. */
  title: string;
  /** Public video cover image. */
  poster: string;
  /** Optional human-readable duration. */
  duration?: string;
}
const { bvid, title, poster, duration } = Astro.props;
---

<div class="life-video" data-life-video data-bvid={bvid} data-title={title}>
  <button class="video-cover" type="button" data-video-play aria-label={`播放视频：${title}`}>
    <img src={poster} alt={`${title}的视频封面`} referrerpolicy="no-referrer" width="1280" height="720" loading="lazy" />
    <span class="video-shade"></span>
    <span class="video-play-icon" aria-hidden="true"><svg width="19" height="22" viewBox="0 0 19 22" fill="none"><path d="M2 1.5 17.5 11 2 20.5V1.5Z" fill="currentColor"/></svg></span>
    <span class="video-cover-label"><span>播放视频</span><small>BILIBILI {duration && `· ${duration}`}</small></span>
    <span class="video-corner" aria-hidden="true">↗</span>
  </button>
  <div class="video-player" data-video-player hidden></div>
</div>

<script>
  /** Start the external player only in response to the visitor's play action. */
  function initializeLifeVideos() {
    document.querySelectorAll<HTMLElement>('[data-life-video]').forEach((video) => {
      if (video.dataset.initialized) return;
      video.dataset.initialized = 'true';
      const button = video.querySelector<HTMLButtonElement>('[data-video-play]')!;
      const player = video.querySelector<HTMLElement>('[data-video-player]')!;
      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.bilibili.com/player.html?bvid=${encodeURIComponent(video.dataset.bvid!)}&autoplay=1&danmaku=0`;
        iframe.title = video.dataset.title || '视频播放器';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        player.replaceChildren(iframe);
        button.hidden = true;
        player.hidden = false;
        iframe.focus();
      });
    });
  }
  initializeLifeVideos();
  document.addEventListener('astro:page-load', initializeLifeVideos);
</script>

<style>
  .life-video{position:relative;background:#11252c;border-radius:10px;overflow:hidden;aspect-ratio:16/9}.video-cover{display:block;position:relative;width:100%;height:100%;border:0;padding:0;background:#11252c;text-align:left;color:#fff}.video-cover[hidden]{display:none}.video-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .65s cubic-bezier(.2,.65,.3,1);opacity:.92}.video-cover:hover img{transform:scale(1.04)}.video-shade{position:absolute;inset:0;background:linear-gradient(0deg,#071923d9,transparent 65%)}.video-play-icon{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:62px;height:62px;border:1px solid #ffffffb3;border-radius:50%;background:#f4fff32b;backdrop-filter:blur(8px);transition:background .2s}.video-play-icon svg{margin-left:4px}.video-cover:hover .video-play-icon{background:#f4fff34d}.video-cover-label{position:absolute;left:26px;bottom:22px;display:flex;flex-direction:column;gap:6px;font-size:15px}.video-cover-label small{font:9px var(--font-display);letter-spacing:.12em;color:#d5e5e5}.video-corner{position:absolute;right:26px;bottom:22px;font-size:24px}.video-player{width:100%;height:100%}.video-player[hidden]{display:none}.video-player :global(iframe){display:block;width:100%;height:100%;border:0}
  @media(max-width:600px){.video-play-icon{width:48px;height:48px}.video-play-icon svg{width:15px}.video-cover-label{left:18px;bottom:15px;font-size:12px}.video-corner{right:18px;bottom:14px}}
</style>
